# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# ------------------------------------------------------------------ LLM
# gemini | openai | anthropic
# Free demo:        LLM_PROVIDER=gemini   (Google AI Studio key, free tier, no card needed)
# Recommended prod: LLM_PROVIDER=openai + LLM_FALLBACK_PROVIDER=gemini  (see README section 7)
LLM_PROVIDER=gemini
# Empty = default model of the provider:
#   gemini -> gemini-3.1-flash-lite | openai -> gpt-6-luna | anthropic -> claude-haiku-5-5
LLM_MODEL=
# Optional second provider used automatically if the first one fails
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

LLM_MAX_OUTPUT_TOKENS=8000
LLM_TIMEOUT_SECONDS=90
# OpenAI reasoning effort (none|low|medium|high). Reasoning tokens are billed as output.
# Leave empty if you switch to an OpenAI model without reasoning support.
OPENAI_REASONING_EFFORT=low
# Gemini thinking level (minimal|low|medium|high). Empty = model default.
GEMINI_THINKING_LEVEL=
# Only needed for a model that is not in the built-in price table (USD per 1M tokens)
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=

# ------------------------------------------------------------------ Competitor research (optional)
# With a Brave Search API key, competitors are grounded in live search results (source="web_search").
# Without it, competitors are labelled source="ai_suggestion".  https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# ------------------------------------------------------------------ Website fetching
FETCH_TIMEOUT_SECONDS=15
MAX_HTML_BYTES=2000000
MAX_REDIRECTS=5
# Characters of main-page text sent to the LLM (biggest cost lever)
MAX_CONTENT_CHARS=12000
# Extra pages (services/about) fetched to understand the business; 0 disables
MAX_SUBPAGES=2
SUBPAGE_CONTENT_CHARS=3000
ALLOWED_PORTS=80,443

# ------------------------------------------------------------------ Misc
# Results are cached per URL+model (seconds); 0 disables the cache
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=256
# Optional: if set, POST /link-analysis requires header X-API-Key
ANALYSIS_API_KEY=
OUTPUT_LANGUAGE=English
# Comma separated origins allowed to call the API from a browser (empty = CORS off)
CORS_ORIGINS=
