{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run API (uvicorn :4000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "4000", "--reload"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
